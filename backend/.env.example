# Local : mongodb://localhost:27017 — Atlas : mongodb+srv://user:motdepasse@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=proservices
REDIS_URL=redis://localhost:6379
SECRET_KEY=changeme-secret-key-in-production-at-least-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7
DEBUG=true
# Paiements simulés sans DEBUG (démo déployée). false en vraie production.
PAYMENT_SIMULATION=false
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
UPLOAD_DIR=uploads

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
FROM_EMAIL=noreply@proservices.fr
FRONTEND_URL=http://localhost:5173
PUBLIC_API_URL=http://localhost:8000

MTN_MOMO_API_KEY=
MTN_MOMO_SUBSCRIPTION_KEY=
MTN_MOMO_ENVIRONMENT=sandbox

ORANGE_MONEY_CLIENT_ID=
ORANGE_MONEY_CLIENT_SECRET=
