# Backend
SECRET_KEY=changeme-secret-key-in-production-at-least-32-chars
DEBUG=false
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Frontend
VITE_API_URL=http://localhost:8000

# Email SMTP
